# -------------------------------------------------------------
# ForgeCode AI — Production & Local Environment Configuration
# -------------------------------------------------------------

# Web Service Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_URL=https://forgecode.voroa.app
APP_SECRET_KEY=9f83a8b2d31c4f5e6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f

# Voroa / Managed PostgreSQL Connection String
DATABASE_URL=postgresql://user:password@host:5432/forgecodedb?sslmode=require

# Persistent File Storage Driver: "postgres" | "s3" | "local"
STORAGE_DRIVER=postgres
STORAGE_LOCAL_DIR=./storage/workspaces

# Optional S3 / Cloudflare R2 Object Storage (when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=forgecode-workspaces
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# Default AI Provider Settings (Optional server defaults; users can configure keys in IDE)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# MCP Configuration
MCP_BASE_PATH=/mcp
MCP_SESSION_TIMEOUT_MS=3600000

# Execution & Terminal Settings
ENABLE_TERMINAL=true
MAX_EXECUTION_TIME_SEC=300
